datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Log {
  id       Int      @id @default(autoincrement())
  date     DateTime @db.Date
  username String   @db.VarChar(50)
  action   String   @db.VarChar(50)
  status   String   @db.VarChar(10)

  @@map("logs")
}